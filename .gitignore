__pycache__/
*.pyc
*.egg-info/
.venv/
dist/
build/
log/
*.log
.env
WORKFLOW.md
docs/plans/

# Workflow config (operator-local)
workflow.yaml
workflow.yml

# Prompt files (operator-local, examples are tracked)
prompts/*.md
!prompts/*.example.md

# Workflow files (operator-local, examples are tracked). Same convention as
# prompts: an operator's `bug-fix.yaml` shadows the shipped
# `bug-fix.example.yaml`, and only the example is version-controlled here.
workflows/*.yaml
workflows/*.yml
!workflows/*.example.yaml
!workflows/*.example.yml

# Playwright MCP writes here (it refuses paths outside the repo root)
.playwright-mcp/

# Run ledger (operator-local)
.stokowski/
